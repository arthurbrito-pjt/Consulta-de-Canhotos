rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }

    function docUsuario(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    // Usuário autenticado, com perfil válido em /usuarios e não desativado (ativo != false)
    function temPerfil() {
      return logado()
        && exists(docUsuario(request.auth.uid))
        && get(docUsuario(request.auth.uid)).data.perfil in
           ['rotas', 'fiscal', 'comercial', 'gestao_rotas']
        && get(docUsuario(request.auth.uid)).data.get('ativo', true) == true;
    }

    // Administrador: perfil válido, ativo e campo admin == true (concedido pelo Console ou por outro admin)
    function ehAdmin() {
      return temPerfil()
        && get(docUsuario(request.auth.uid)).data.get('admin', false) == true;
    }

    // Documento de usuário gravado por um admin (criação ou edição)
    function usuarioValido(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['nome', 'perfil'])
        && d.keys().hasOnly(['nome', 'email', 'perfil', 'admin', 'ativo', 'criadoEm', 'criadoPor'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && (!('email' in d) || (d.email is string && d.email.size() <= 200))
        && d.perfil in ['rotas', 'fiscal', 'comercial', 'gestao_rotas']
        && (!('admin' in d) || d.admin is bool)
        && (!('ativo' in d) || d.ativo is bool)
        // ninguém tira o próprio acesso de admin nem se desativa (evita ficar sem administrador)
        && (uid != request.auth.uid
            || (d.get('admin', false) == true && d.get('ativo', true) == true));
    }

    function ehRotas() {
      return temPerfil()
        && get(docUsuario(request.auth.uid)).data.perfil == 'rotas';
    }

    function textoOpcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }

    function canhotoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['numeroNota', 'cliente', 'clienteBusca', 'dataAssinatura', 'criadoPor', 'criadoEm'])
        && d.keys().hasOnly(['numeroNota', 'cliente', 'clienteBusca', 'dataAssinatura',
                             'assinadoPor', 'observacao', 'criadoPor', 'criadoEm'])
        && d.numeroNota is string && d.numeroNota.size() > 0 && d.numeroNota.size() <= 20
        && d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 200
        && d.clienteBusca is string && d.clienteBusca.size() > 0 && d.clienteBusca.size() <= 200
        && d.dataAssinatura is timestamp
        && textoOpcional(d, 'assinadoPor', 200)
        && textoOpcional(d, 'observacao', 1000)
        && d.criadoPor == request.auth.uid
        && d.criadoEm == request.time;
    }

    // Substituição (re-digitalização da mesma NF/cliente): identidade e autoria ficam intactas;
    // só data, assinatura e observação mudam, com carimbo de quem atualizou.
    function canhotoSubstituivel() {
      let d = request.resource.data;
      let a = resource.data;
      return d.keys().hasAll(['numeroNota', 'cliente', 'clienteBusca', 'dataAssinatura', 'criadoPor', 'criadoEm',
                              'atualizadoPor', 'atualizadoEm'])
        && d.keys().hasOnly(['numeroNota', 'cliente', 'clienteBusca', 'dataAssinatura',
                             'assinadoPor', 'observacao', 'criadoPor', 'criadoEm', 'atualizadoPor', 'atualizadoEm'])
        && d.numeroNota == a.numeroNota
        && d.cliente == a.cliente
        && d.clienteBusca == a.clienteBusca
        && d.criadoPor == a.criadoPor
        && d.criadoEm == a.criadoEm
        && d.dataAssinatura is timestamp
        && textoOpcional(d, 'assinadoPor', 200)
        && textoOpcional(d, 'observacao', 1000)
        && d.atualizadoPor == request.auth.uid
        && d.atualizadoEm == request.time;
    }

    function imagemValida() {
      return request.resource.data.keys().hasOnly(['imagemBase64', 'mimeType'])
        && request.resource.data.imagemBase64 is string
        && request.resource.data.imagemBase64.size() > 0
        && request.resource.data.imagemBase64.size() <= 900000
        && request.resource.data.mimeType in ['image/jpeg', 'image/png'];
    }

    // ---------- Coleções ----------
    // (canhotos_versos: foto opcional do verso/observação do canhoto, mesmas regras da imagem)

    // Cada usuário lê o próprio perfil (mesmo desativado, para o app avisar). Admin lista, cria e edita.
    // Não há exclusão: usuários são desativados (ativo: false).
    match /usuarios/{uid} {
      allow get: if logado() && (request.auth.uid == uid || ehAdmin());
      allow list: if ehAdmin();
      allow create: if ehAdmin() && usuarioValido(uid) && request.resource.data.criadoPor == request.auth.uid;
      allow update: if ehAdmin() && usuarioValido(uid);
      allow delete: if false;
    }

    // Todos os perfis consultam; só "rotas" insere e substitui (mesma NF/cliente); não há exclusão.
    match /canhotos/{id} {
      allow read: if temPerfil();
      allow create: if ehRotas() && canhotoValido();
      allow update: if ehRotas() && canhotoSubstituivel();
      allow delete: if false;
    }

    // Imagem em base64 (separada para não pesar nas listagens).
    // Só pode ser criada junto com o canhoto (mesmo batch) e abaixo de ~900 KB.
    match /canhotos_versos/{id} {
      allow read: if temPerfil();
      allow create: if ehRotas()
        && imagemValida()
        && existsAfter(/databases/$(database)/documents/canhotos/$(id));
      allow update: if ehRotas()
        && imagemValida()
        && getAfter(/databases/$(database)/documents/canhotos/$(id)).data.get('atualizadoEm', null) == request.time;
      allow delete: if false;
    }

    match /canhotos_imagens/{id} {
      allow read: if temPerfil();
      allow create: if ehRotas()
        && imagemValida()
        && existsAfter(/databases/$(database)/documents/canhotos/$(id));
      // A foto só é trocada junto com a substituição do canhoto (mesmo batch, carimbo atualizadoEm == agora).
      allow update: if ehRotas()
        && imagemValida()
        && getAfter(/databases/$(database)/documents/canhotos/$(id)).data.get('atualizadoEm', null) == request.time;
      allow delete: if false;
    }
  }
}
