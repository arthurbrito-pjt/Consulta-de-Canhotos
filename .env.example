# Copie para .env.local e preencha com os valores do app web (Console Firebase >
# Configurações do projeto > Seus apps > Config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# Chave de SITE do reCAPTCHA v3 (App Check). Pública.
VITE_RECAPTCHA_SITE_KEY=

# "true" para usar os emuladores locais (Auth 9099, Firestore 8080)
VITE_USE_EMULATORS=false
