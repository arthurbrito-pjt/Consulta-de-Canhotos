# Copie para .env.local e preencha com os valores do app web (Console Firebase >
# Configurações do projeto > Seus apps > Config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mesma região da Cloud Function (functions/src/index.ts)
VITE_FUNCTIONS_REGION=southamerica-east1

# "true" para usar os emuladores locais (Auth 9099, Firestore 8080, Functions 5001)
VITE_USE_EMULATORS=false
